using System;

namespace Lab2Task3
{
    /// <summary>
    /// Клас для обробки одновимірного масиву (ООП підхід)
    /// </summary>
    public class ArrayProcessor
    {
        private int[] data;

        // Конструктор за розміром
        public ArrayProcessor(int n)
        {
            data = new int[n];
        }

        // Конструктор для тестування (приймає готовий масив)
        public ArrayProcessor(int[] initialData)
        {
            data = initialData;
        }

        // --- МЕТОДИ ЗАПОВНЕННЯ ТА ВИВЕДЕННЯ ---

        public void FillFromKeyboard()
        {
            Console.WriteLine("\nВведіть елементи масиву:");
            for (int i = 0; i < data.Length; i++)
            {
                Console.Write($"Елемент [{i}]: ");
                data[i] = int.Parse(Console.ReadLine());
            }
        }

        public void FillRandomly()
        {
            Random rnd = new Random();
            for (int i = 0; i < data.Length; i++)
            {
                data[i] = rnd.Next(-100, 101);
            }
        }

        public void PrintArray()
        {
            Console.WriteLine("Масив: " + string.Join(", ", data));
        }

        // --- МЕТОДИ ДЛЯ ПОШУКУ МАКСИМАЛЬНОГО ЕЛЕМЕНТА ---

        public int GetMaxElementIndex()
        {
            int maxIndex = 0;
            for (int i = 1; i < data.Length; i++)
            {
                if (data[i] > data[maxIndex])
                {
                    maxIndex = i;
                }
            }
            return maxIndex;
        }

        public int GetMaxElementValue()
        {
            int maxIndex = GetMaxElementIndex();
            return data[maxIndex];
        }

        // --- ДОПОМІЖНІ МЕТОДИ ДЛЯ ОБЧИСЛЕННЯ СУМИ МІЖ НУЛЯМИ ---

        public int FindFirstZeroIndex()
        {
            for (int i = 0; i < data.Length; i++)
            {
                if (data[i] == 0) return i;
            }
            return -1;
        }

        public int FindLastZeroIndex()
        {
            for (int i = data.Length - 1; i >= 0; i--)
            {
                if (data[i] == 0) return i;
            }
            return -1;
        }

        public int CalculateAbsSumBetweenIndices(int start, int end)
        {
            int sum = 0;
            for (int i = start + 1; i < end; i++)
            {
                sum += Math.Abs(data[i]);
            }
            return sum;
        }

        public int GetSumOfAbsBetweenZeros()
        {
            int firstZero = FindFirstZeroIndex();
            int lastZero = FindLastZeroIndex();

            if (firstZero == -1 || lastZero == -1 || firstZero >= lastZero)
            {
                return -1;
            }

            return CalculateAbsSumBetweenIndices(firstZero, lastZero);
        }
    }

    class Program
    {
        static void Main(string[] args)
        {
            // Налаштування кодування для коректного відображення української мови (і, ї, є)
            Console.OutputEncoding = System.Text.Encoding.UTF8;

            bool repeat = true;
            while (repeat)
            {
                RunTask();
                repeat = AskForRepeat();
                Console.WriteLine();
            }
        }

        // Головна функція виконання одного циклу завдання
        static void RunTask()
        {
            int n = ReadInt("Введіть розмір масиву n: ");
            ArrayProcessor processor = new ArrayProcessor(n);

            FillArrayMenu(processor);

            Console.WriteLine("\n--- Результати ---");
            processor.PrintArray();

            DisplayMaxElementInfo(processor);
            DisplaySumBetweenZerosInfo(processor);
        }

        // Допоміжна функція для зчитування цілого числа
        static int ReadInt(string prompt)
        {
            Console.Write(prompt);
            return int.Parse(Console.ReadLine());
        }

        // Функція керування вибором способу заповнення
        static void FillArrayMenu(ArrayProcessor processor)
        {
            int choice = ReadInt("Спосіб заповнення (1 - з клавіатури, 2 - випадкові числа): ");
            if (choice == 1)
            {
                processor.FillFromKeyboard();
            }
            else
            {
                processor.FillRandomly();
            }
        }

        // Функція виведення інформації про максимальний елемент
        static void DisplayMaxElementInfo(ArrayProcessor processor)
        {
            int maxIndex = processor.GetMaxElementIndex();
            int maxValue = processor.GetMaxElementValue();
            Console.WriteLine($"1) Номер (індекс) максимального елемента: {maxIndex} (Значення: {maxValue})");
        }

        // Функція виведення суми між нулями
        static void DisplaySumBetweenZerosInfo(ArrayProcessor processor)
        {
            int sum = processor.GetSumOfAbsBetweenZeros();
            if (sum != -1)
            {
                Console.WriteLine($"2) Сума модулів між першим та останнім нулями: {sum}");
            }
            else
            {
                Console.WriteLine("2) У масиві немає двох нулів для обчислення суми.");
            }
        }

        // Функція запиту на повторення програми
        static bool AskForRepeat()
        {
            int exitChoice = ReadInt("\nБажаєте виконати програму знову? (1 - Так, 0 - Вихід): ");
            return exitChoice == 1;
        }
    }
}
