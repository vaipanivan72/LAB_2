using System;

namespace Lab2Task5
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;

            bool repeat = true;

            // Цикл повторного виконання всієї програми
            while (repeat)
            {
                Console.Clear();
                Console.WriteLine("=== ПРОГРАМА ОБРОБКИ ДВОВИМІРНОГО МАСИВУ (МАТРИЦІ) ===");

                // Запуск одного сеансу виконання задачі
                RunTask();

                Console.WriteLine("\n-------------------------------------------");
                int exitChoice = GetValidInt("Бажаєте виконати програму знову? (1 - Так, 0 - Вихід): ", 0, 1);

                if (exitChoice == 0)
                {
                    repeat = false;
                    Console.WriteLine("\nРоботу програми завершено. Натисніть будь-яку клавішу...");
                    Console.ReadKey();
                }
            }
        }

        // Функція виконання одного сеансу роботи з матрицею
        static void RunTask()
        {
            int n = GetValidInt("\nВведіть кількість рядків n (> 0): ", 1, 100);
            int m = GetValidInt("Введіть кількість стовпців m (> 0): ", 1, 100);

            int[,] A = new int[n, m];

            // Вибір та виклик способу заповнення
            FillMatrixMenu(A, n, m);

            // Виведення початкової матриці
            PrintMatrix(A, n, m);

            // Обчислення найбільших елементів рядків та їх суми
            int[] rowMaxes = GetRowMaxes(A, n, m);
            int totalSum = CalculateSum(rowMaxes);

            // Виведення результатів
            DisplayResults(rowMaxes, totalSum);
        }

        // Меню вибору способу заповнення матриці
        static void FillMatrixMenu(int[,] A, int n, int m)
        {
            int choice = GetValidInt("\nОберіть спосіб заповнення (1 - з клавіатури, 2 - випадковими числами): ", 1, 2);

            if (choice == 1)
            {
                FillFromKeyboard(A, n, m);
            }
            else
            {
                FillRandomly(A, n, m);
            }
        }

        // Функція пошуку найбільшого елемента у кожному рядку
        static int[] GetRowMaxes(int[,] A, int n, int m)
        {
            int[] maxes = new int[n];
            for (int i = 0; i < n; i++)
            {
                int maxInRow = A[i, 0];
                for (int j = 1; j < m; j++)
                {
                    if (A[i, j] > maxInRow)
                    {
                        maxInRow = A[i, j];
                    }
                }
                maxes[i] = maxInRow;
            }
            return maxes;
        }

        // Функція підрахунку суми елементів одновимірного масиву
        static int CalculateSum(int[] numbers)
        {
            int sum = 0;
            foreach (int val in numbers)
            {
                sum += val;
            }
            return sum;
        }

        // Функція виведення проміжних та кінцевих результатів
        static void DisplayResults(int[] rowMaxes, int totalSum)
        {
            Console.WriteLine("\n--- Проміжні результати (максимуми в кожному рядку) ---");
            for (int i = 0; i < rowMaxes.Length; i++)
            {
                Console.WriteLine($"Рядок {i + 1}: найбільший елемент = {rowMaxes[i]}");
            }

            Console.WriteLine("\n--- Кінцевий результат ---");
            Console.WriteLine($"Сума найбільших елементів усіх рядків: {totalSum}");
        }

        // Заповнення з клавіатури із перевіркою типу даних
        static void FillFromKeyboard(int[,] A, int n, int m)
        {
            Console.WriteLine("\nВведіть цілі числа для елементів матриці:");
            for (int i = 0; i < n; i++)
            {
                for (int j = 0; j < m; j++)
                {
                    A[i, j] = GetValidInt($"Елемент [{i + 1}, {j + 1}]: ", int.MinValue, int.MaxValue);
                }
            }
        }

        // Заповнення випадковими числами з відрізка [-100; 100]
        static void FillRandomly(int[,] A, int n, int m)
        {
            Random rnd = new Random();
            for (int i = 0; i < n; i++)
            {
                for (int j = 0; j < m; j++)
                {
                    A[i, j] = rnd.Next(-100, 101);
                }
            }
        }

        // Виведення двовимірного масиву у вигляді таблиці
        static void PrintMatrix(int[,] A, int n, int m)
        {
            Console.WriteLine("\n--- Початкова матриця A ---");
            for (int i = 0; i < n; i++)
            {
                for (int j = 0; j < m; j++)
                {
                    Console.Write($"{A[i, j],7}");
                }
                Console.WriteLine();
            }
        }

        // Валідатор введення цілих чисел з клавіатури
        static int GetValidInt(string prompt, int min, int max)
        {
            while (true)
            {
                Console.Write(prompt);
                if (int.TryParse(Console.ReadLine(), out int result) && result >= min && result <= max)
                {
                    return result;
                }
                Console.WriteLine("Помилка: введено некоректне значення або число поза допустимим діапазоном.");
            }
        }
    }
}
